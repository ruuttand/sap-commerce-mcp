#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require_relative '../lib/sap_commerce_mcp'

# Get project path from command line, environment variable, or current directory
project_path = ARGV[0] || ENV['SAP_COMMERCE_PROJECT_PATH'] || Dir.pwd
project_path = File.expand_path(project_path)

warn "Starting SAP Commerce MCP Server..."
warn "Project: #{project_path}"

# Ensure data directories exist
SapCommerceMcp.ensure_data_dir!

# Check parser selection: tree-sitter by default, regex as fallback or explicit opt-out
use_regex_parser = ENV['SAP_MCP_USE_REGEX_PARSER'] == 'true'

if use_regex_parser
  use_tree_sitter = false
  warn "Using regex parser (explicitly enabled)"
elsif !defined?(TreeSitter)
  warn "Warning: tree_sitter gem not available, falling back to regex parser"
  use_tree_sitter = false
else
  use_tree_sitter = true
  warn "Using tree-sitter Java parser (default)"
end

# Initialize indexer and audit logger
indexer = SapCommerceMcp::Indexer.new(project_path, use_tree_sitter: use_tree_sitter)
audit_logger = SapCommerceMcp::Audit::Logger.new(project_path)

# Build index if it doesn't exist
if indexer.index_exists?
  # Ensure database is opened for existing index
  indexer.ensure_db_open
  warn "Using existing index (last indexed: #{indexer.last_indexed_time&.strftime('%Y-%m-%d %H:%M:%S')})"
else
  warn "No index found. Building initial index..."
  stats = indexer.build_index
  audit_logger.log_indexing(stats)
  warn "Index built: #{stats[:classes_count]} classes, #{stats[:methods_count]} methods"
end

warn "Index location: #{indexer.db_path}"
warn "Audit logs: #{audit_logger.log_path}"

# Configure server context that will be passed to all tools
server_context = {
  indexer: indexer,
  audit_logger: audit_logger,
  project_path: project_path
}

# Tool classes (not instances) - the SDK will call class methods
tools = [
  SapCommerceMcp::Tools::SearchClasses,
  SapCommerceMcp::Tools::GetClassSignature,
  SapCommerceMcp::Tools::FindImplementations,
  SapCommerceMcp::Tools::FindUsages,
  SapCommerceMcp::Tools::SearchAnnotations,
  SapCommerceMcp::Tools::GetSpringBeans,
  SapCommerceMcp::Tools::FindInjectedDependencies,
  SapCommerceMcp::Tools::RebuildIndex,
  SapCommerceMcp::Tools::GetIndexStats
]

# Create MCP server with official SDK
server = MCP::Server.new(
  name: 'sap-commerce-mcp',
  version: '0.1.0',
  tools: tools,
  server_context: server_context
)

warn "Registered #{server.tools.size} tools"
warn "Ready to receive MCP requests via stdio..."

# Connect using stdio transport (for Claude Code)
transport = MCP::Server::Transports::StdioTransport.new(server)
transport.open

# Cleanup on exit
at_exit do
  indexer.close
  audit_logger.log_indexing({ event: 'server_stop' })
end
